<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@BellumOverviewSelected" MarginRight="42" MarginBottom="110">
      <Children>
        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="15" AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\Sections" VerticalScrollbar="..\Scrollbar">
          <Children>
            <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
              <Children>
                <ListPanel Id="Sections" DataSource="{BellumOverview\Sections}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="8" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" Brush="Kingdom.TitleMedium.Text" Brush.FontSize="24" Text="@Title" DoNotAcceptEvents="true" />
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="@BodyHeight" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginRight="12">
                              <Children>
                                <GridWidget DataSource="{Left}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" DefaultCellWidth="112" DefaultCellHeight="132" ColumnCount="4" HorizontalAlignment="Right" LayoutImp.HorizontalLayoutMethod="RightToLeft">
                                  <ItemTemplate><BellumDiplomacyOverviewRealm /></ItemTemplate>
                                </GridWidget>
                              </Children>
                            </Widget>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" Sprite="BlankWhiteSquare_9" Color="#B99C64FF" AlphaFactor="0.5" DoNotAcceptEvents="true" />
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="12">
                              <Children>
                                <GridWidget DataSource="{Right}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" DefaultCellWidth="112" DefaultCellHeight="132" ColumnCount="4" HorizontalAlignment="Left" LayoutImp.HorizontalLayoutMethod="LeftToRight">
                                  <ItemTemplate><BellumDiplomacyOverviewRealm /></ItemTemplate>
                                </GridWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </ListPanel>
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </ScrollablePanel>
        <ScrollbarWidget Id="Scrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="Handle" MinValue="0" MaxValue="100">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#ECC79BFF" />
            <ImageWidget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="6" SuggestedHeight="10" HorizontalAlignment="Center" Brush="Kingdom.Scrollbar.Handle" />
          </Children>
        </ScrollbarWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
