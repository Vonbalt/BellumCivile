<Prefab>
  <Constants>
    <Constant Name="Bellum.Hierarchy.Tree.Banner.Width" BrushLayer="Default" BrushName="Flat.Tuple.Banner.Small" BrushValueType="Width" />
    <Constant Name="Bellum.Hierarchy.Tree.Banner.Height" BrushLayer="Default" BrushName="Flat.Tuple.Banner.Small" BrushValueType="Height" />
    <Constant Name="Bellum.Hierarchy.Tree.Banner.Width.Scaled" MultiplyResult="0.30" Value="!Bellum.Hierarchy.Tree.Banner.Width" />
    <Constant Name="Bellum.Hierarchy.Tree.Banner.Height.Scaled" MultiplyResult="0.38" Value="!Bellum.Hierarchy.Tree.Banner.Height" />
    <Constant Name="Bellum.Hierarchy.Tree.Line.Height" BrushLayer="Default" BrushName="Encyclopedia.CharacterTree.Line" BrushValueType="Height" />
  </Constants>
  <Window>
    <EncyclopediaUnitTreeNodeItemBrushWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="@RightMargin" ButtonContainer="ButtonContainer" ChildContainer="ChildContainer" LineContainer="LineContainer" LineBrush="Encyclopedia.CharacterTree.Line" AlternateLineBrush="Encyclopedia.CharacterTree.Line.Alternative">
      <Children>
        <Widget Id="ButtonContainer" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="150" SuggestedWidth="128" HorizontalAlignment="Center" MarginRight="8">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="112" SuggestedHeight="120" HorizontalAlignment="Center">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Encyclopedia.NoAudioButton" Command.Click="ExecuteSelect" Command.AlternateClick="ExecuteOpenClan" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" UpdateChildrenStates="true" IsSelected="@IsSelected">
                  <Children>
                    <MaskedTextureWidget DoNotAcceptEvents="true" DataSource="{BannerVisual}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Bellum.Hierarchy.Tree.Banner.Width.Scaled" SuggestedHeight="!Bellum.Hierarchy.Tree.Banner.Height.Scaled" HorizontalAlignment="Right" VerticalAlignment="Top" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" Brush="Flat.Tuple.Banner.Small.Hero" />
                    <ImageIdentifierWidget DataSource="{PortraitVisual}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="74" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="6" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" VerticalAlignment="Bottom" Brush="Kingdom.PoliciesCollapserTitle.Text" Brush.FontSize="18" Brush.FontColor="@TitleColor" Text="@Name" />
                    <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="SelectionBorder@2x_9" IsVisible="@IsSelected" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <HierarchyOptionsButtonWidget IsVisible="@IsSelected" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="128" SuggestedHeight="28" VerticalAlignment="Top" MarginTop="122" Brush="SPOptions.Dropdown.Center" DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Dropdown.Center.Text" Brush.FontSize="18" Text="@OptionsText" />
              </Children>
            </HierarchyOptionsButtonWidget>
          </Children>
        </Widget>

        <Widget Id="LineContainer" DoNotAcceptEvents="true" DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="!Bellum.Hierarchy.Tree.Line.Height" HorizontalAlignment="Center" MarginTop="164" />

        <ListPanel Id="ChildContainer" DataSource="{Branch}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="198" DoNotAcceptEvents="true" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <ItemTemplate>
            <BellumHierarchyTitleTreeNode />
          </ItemTemplate>
        </ListPanel>
      </Children>
    </EncyclopediaUnitTreeNodeItemBrushWidget>
  </Window>
</Prefab>
